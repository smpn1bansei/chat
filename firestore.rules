rules_version = '2';

// =============================================================
//  EDUCHAT — Aturan keamanan Cloud Firestore
//  - Guru  : login Email/Password (bukan anonymous)
//  - Siswa : login Anonymous (otomatis saat masuk room)
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Profil guru
    match /teachers/{uid} {
      allow read: if signedIn();
      allow write: if isTeacher() && request.auth.uid == uid;

      // Bank soal pribadi guru
      match /bank/{id} {
        allow read, write: if isTeacher() && request.auth.uid == uid;
      }
    }

    match /rooms/{code} {
      function roomData() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
      function isOwner() { return isTeacher() && roomData().ownerUid == request.auth.uid; }
      function playerPath(uid) { return /databases/$(database)/documents/rooms/$(code)/players/$(uid); }

      // Semua pengguna yang login boleh melihat daftar room (termasuk milik guru lain)
      allow read: if signedIn();

      // Kode 4 digit = ID dokumen → otomatis unik. "create" hanya berlaku bila
      // dokumen belum ada, sehingga kode milik guru lain tidak bisa ditimpa.
      allow create: if isTeacher()
        && code.matches('^[0-9]{4}$')
        && request.resource.data.code == code
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.settings.answerMode in ['single', 'multiple']
        && request.resource.data.settings.maxFastest is int
        && request.resource.data.settings.defaultPoints is int;

      // Hanya pembuat room yang boleh mengelola / menghapus
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.code == resource.data.code;
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      // Siswa (pid) dimiliki oleh perangkat yang uid-nya tercatat di dokumen siswa
      function ownsPlayer(pid) {
        return exists(playerPath(pid))
          && get(playerPath(pid)).data.uid == request.auth.uid
          && get(playerPath(pid)).data.kicked == false;
      }

      // ---------------- Peserta ----------------
      // ID dokumen = kelas + no. absen, mis. "7-1__5". Field uid = perangkat yang sedang dipakai.
      match /players/{pid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && pid.matches('^[A-Z0-9-]{1,20}__[0-9]{1,3}$')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.absen is int
          && pid.split('__')[1] == string(request.resource.data.absen)
          && request.resource.data.score == 0
          && request.resource.data.kicked == false
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && roomData().status == 'open';
        // Siswa tidak pernah boleh mengubah poin.
        allow update: if isOwner()
          || (signedIn() && resource.data.kicked == false && (
               // perangkat yang sama: perbarui nama / tanda online
               (resource.data.uid == request.auth.uid
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastSeen'])
                 && request.resource.data.name is string
                 && request.resource.data.name.size() <= 40)
               // pindah perangkat: hanya uid & tanda online yang berubah
               || (request.resource.data.uid == request.auth.uid
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'lastSeen']))
             ));
        allow delete: if isOwner();
      }

      // ---------------- Pertanyaan & pengumuman ----------------
      // Hanya guru yang mengubah data soal. Siswa tidak pernah menulis ke sini,
      // sehingga data soal jarang berubah (hemat kuota pembacaan semua HP).
      match /messages/{mid} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner();
      }

      // ---------------- Slot penjawab (terpisah dari data soal) ----------------
      // Siswa "mengambil slot" lewat transaksi: menambah ID siswa (pid) ke responders
      // dan menaikkan answerCount, sesuai mode & batas penjawab tercepat.
      // HP siswa tidak memantau koleksi ini secara langsung.
      match /slots/{qid} {
        function studentTakesSlot() {
          let s = roomData().settings;
          let q = get(/databases/$(database)/documents/rooms/$(code)/messages/$(qid)).data;
          let before = resource.data.responders;
          let after = request.resource.data.responders;
          let pid = request.resource.data.lastResponder;
          return signedIn()
            && pid is string
            && ownsPlayer(pid)
            && roomData().status != 'ended'
            && q.type == 'question'
            && q.status == 'open'
            && request.resource.data.keys().hasOnly(['responders', 'answerCount', 'lastResponder'])
            && request.resource.data.answerCount == resource.data.answerCount + 1
            && (after == before
                || (after.size() == before.size() + 1
                    && after.hasAll(before)
                    && pid in after
                    && !(pid in before)))
            && ((s.answerMode != 'single' && q.get('kind', 'text') != 'mc') || !(pid in before))
            && (s.maxFastest == 0 || after.size() <= s.maxFastest)
            && (q.deadline == null || request.time < q.deadline);
        }

        allow read: if signedIn();
        allow create, delete: if isOwner();
        allow update: if isOwner() || studentTakesSlot();
      }

      // ---------------- Jawaban siswa ----------------
      match /answers/{aid} {
        function canAnswer() {
          let qid = request.resource.data.questionId;
          let q = get(/databases/$(database)/documents/rooms/$(code)/messages/$(qid)).data;
          let slot = getAfter(/databases/$(database)/documents/rooms/$(code)/slots/$(qid)).data;
          let s = roomData().settings;
          let pid = request.resource.data.playerId;
          return pid is string
            && ownsPlayer(pid)
            && q.status == 'open'
            && pid in slot.responders
            && ((s.answerMode != 'single' && q.get('kind', 'text') != 'mc')
                || aid == request.resource.data.questionId + '_' + pid);
        }

        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.points == 0
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && canAnswer();
        // Penilaian (benar/salah) hanya oleh guru pemilik room
        allow update, delete: if isOwner();
      }

      // ---------------- Ringkasan papan skor ----------------
      // Diterbitkan HP guru secara berkala; HP siswa cukup memantau 1 dokumen ini.
      match /board/{doc} {
        allow read: if signedIn();
        allow write: if isOwner();
      }

      // ---------------- Kunci jawaban pilihan ganda ----------------
      // Hanya guru pemilik yang bisa membaca → siswa tidak bisa mengintip kunci.
      match /keys/{qid} {
        allow read, write: if isOwner();
      }

      // ---------------- Tanda online siswa ----------------
      // Dipisah dari dokumen siswa agar detak online tidak memicu pembacaan
      // papan skor di HP semua siswa (hemat kuota).
      match /presence/{pid} {
        allow read: if isOwner() || ownsPlayer(pid);
        allow write: if isOwner()
          || (signedIn() && ownsPlayer(pid)
              && request.resource.data.keys().hasOnly(['lastSeen'])
              && request.resource.data.lastSeen == request.time);
      }
    }
  }
}
